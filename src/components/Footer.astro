---
import { site } from '../site';
---

<footer class="border-t border-ink/10">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-10 text-sm text-muted sm:flex-row sm:justify-between sm:px-6">
    <p>
      © {new Date().getFullYear()} {site.name}. Baked fresh at {site.location}.
      <span class="km" lang="km">ដុតស្រស់ៗនៅ {site.location}។</span>
    </p>
    <p>
      Open from {site.openTime} · <span lang="km" class="font-khmer">បើកពី{site.openTimeKm}</span>
    </p>
  </div>
</footer>
