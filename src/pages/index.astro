---
// The homepage. Each <section> below is one band of the page — ask the AI to
// add, remove, or reorder them. Every `km` field / class="km" line is the Khmer
// caption shown under the English.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

// THE MENU — change names and prices here. TODO: put your real prices.
const menu = [
  {
    icon: '🥐',
    name: 'Butter croissant',
    nameKm: 'នំក្រូសង់ប៊ឺ',
    text: 'Our classic. Golden, flaky, and soft inside.',
    textKm: 'នំបុរាណរបស់យើង។ ពណ៌មាស ស្រួយ និងទន់នៅខាងក្នុង។',
    price: '$1.50',
  },
  {
    icon: '🍫',
    name: 'Chocolate croissant',
    nameKm: 'នំក្រូសង់សូកូឡា',
    text: 'Flaky croissant with warm chocolate in the middle.',
    textKm: 'នំក្រូសង់ស្រួយ ជាមួយសូកូឡាក្តៅនៅកណ្តាល។',
    price: '$2.00',
  },
  {
    icon: '🌰',
    name: 'Almond croissant',
    nameKm: 'នំក្រូសង់គ្រាប់អាល់ម៉ុន',
    text: 'Topped with sliced almonds and a little sugar.',
    textKm: 'ដាក់គ្រាប់អាល់ម៉ុនចិត និងស្ករបន្តិចនៅពីលើ។',
    price: '$2.00',
  },
];

const reasons = [
  {
    icon: '☀️',
    title: 'Baked every morning',
    titleKm: 'ដុតរៀងរាល់ព្រឹក',
    text: 'Fresh from the oven when we open.',
    textKm: 'ស្រស់ពីឡដុត នៅពេលយើងបើក។',
  },
  {
    icon: '🧈',
    title: 'Real butter',
    titleKm: 'ប៊ឺពិតប្រាកដ',
    text: 'That is why our croissants are so flaky.',
    textKm: 'នោះហើយជាមូលហេតុដែលនំក្រូសង់របស់យើងស្រួយខ្លាំង។',
  },
  {
    icon: '🚶',
    title: 'Just walk in',
    titleKm: 'គ្រាន់តែដើរចូល',
    text: 'No order needed. Come and choose.',
    textKm: 'មិនចាំបាច់កម្ម៉ង់ទេ។ មក ហើយជ្រើសរើស។',
  },
];
---

<Base>
  <Header />
  <main>
    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-4 pt-14 pb-16 sm:px-6 sm:pt-20">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full bg-sun/25 px-3 py-1 text-sm font-semibold">
            🕗 Open from {site.openTime} · <span lang="km" class="font-khmer">បើកពី{site.openTimeKm}</span>
          </p>
          <h1 class="mt-5 font-display text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl">
            Fresh croissants, <span class="text-brand">every morning.</span>
            <span class="km" lang="km">នំក្រូសង់ស្រស់ៗ រៀងរាល់ព្រឹក។</span>
          </h1>
          <p class="mt-5 max-w-xl text-lg text-muted">
            Warm, buttery, and baked at {site.location}. Walk in and try one today.
            <span class="km" lang="km">ក្តៅៗ មានក្លិនប៊ឺ ហើយដុតនៅ {site.location}។ ដើរចូលមក ហើយសាកល្បងមួយថ្ងៃនេះ។</span>
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#menu" class="rounded-full bg-brand px-6 py-3 font-semibold text-paper hover:bg-brand-dark">
              See menu <span lang="km" class="font-khmer font-normal">មើលម៉ឺនុយ</span>
            </a>
            <a href="#visit" class="rounded-full bg-white px-6 py-3 font-semibold ring-1 ring-ink/10 hover:bg-ink hover:text-paper">
              Visit us <span lang="km" class="font-khmer font-normal">មកលេងយើង</span>
            </a>
          </div>
        </div>
        <div class="mx-auto flex aspect-square w-full max-w-sm items-center justify-center rounded-full bg-sun/30 text-[9rem] shadow-inner sm:text-[11rem]" aria-hidden="true">
          🥐
        </div>
      </div>
    </section>

    <!-- Menu -->
    <section id="menu" class="scroll-mt-20 bg-white/60 py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="font-display text-3xl font-bold sm:text-4xl">
          Menu
          <span class="km" lang="km">ម៉ឺនុយ</span>
        </h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          {
            menu.map((m) => (
              <div class="flex flex-col rounded-2xl bg-paper p-6 ring-1 ring-ink/5">
                <p class="text-5xl">{m.icon}</p>
                <h3 class="mt-4 font-display text-xl font-bold">
                  {m.name}
                  <span class="km" lang="km">{m.nameKm}</span>
                </h3>
                <p class="mt-2 flex-1 text-muted">
                  {m.text}
                  <span class="km" lang="km">{m.textKm}</span>
                </p>
                <p class="mt-4 font-display text-2xl font-extrabold text-brand">{m.price}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Why us -->
    <section class="py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="font-display text-3xl font-bold sm:text-4xl">
          Why people love us
          <span class="km" lang="km">ហេតុអ្វីមនុស្សចូលចិត្តយើង</span>
        </h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          {
            reasons.map((r) => (
              <div class="rounded-2xl bg-white p-6 ring-1 ring-ink/5">
                <p class="text-3xl">{r.icon}</p>
                <h3 class="mt-3 font-display text-xl font-bold">
                  {r.title}
                  <span class="km" lang="km">{r.titleKm}</span>
                </h3>
                <p class="mt-2 text-muted">
                  {r.text}
                  <span class="km" lang="km">{r.textKm}</span>
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Visit us -->
    <section id="visit" class="scroll-mt-20 bg-ink py-16 text-paper">
      <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
        <h2 class="font-display text-3xl font-bold sm:text-4xl">
          Visit us
          <span class="km" lang="km">មកលេងយើង</span>
        </h2>
        <div class="mt-8 grid gap-4 text-left sm:grid-cols-2">
          <div class="rounded-2xl bg-paper/10 p-6">
            <p class="text-3xl">📍</p>
            <p class="mt-2 font-semibold">Where <span lang="km" class="font-khmer font-normal">ទីតាំង</span></p>
            <p class="mt-1 text-paper/80">{site.location}</p>
          </div>
          <div class="rounded-2xl bg-paper/10 p-6">
            <p class="text-3xl">🕗</p>
            <p class="mt-2 font-semibold">When <span lang="km" class="font-khmer font-normal">ម៉ោង</span></p>
            <p class="mt-1 text-paper/80">Open from {site.openTime}. Walk in, no order needed.</p>
            <p class="km text-paper/80" lang="km">បើកពី{site.openTimeKm}។ ដើរចូលមក មិនចាំបាច់កម្ម៉ង់ទេ។</p>
          </div>
        </div>
        <p class="mt-10 text-lg text-paper/80">
          Follow us for today's fresh bakes:
          <span class="km" lang="km">តាមដានយើង ដើម្បីដឹងពីនំស្រស់ៗថ្ងៃនេះ៖</span>
        </p>
        <div class="mt-4 flex flex-wrap justify-center gap-3">
          <a href={site.facebook} class="rounded-full bg-sun px-6 py-3 font-semibold text-ink hover:bg-paper">Facebook</a>
          <a href={site.telegram} class="rounded-full bg-sun px-6 py-3 font-semibold text-ink hover:bg-paper">Telegram</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
